# Пример systemd-юнита для запуска бота на VPS в режиме 24/7.
#
# Установка:
#   1. Скопируйте этот файл: sudo cp telegram-bot.service /etc/systemd/system/
#   2. Отредактируйте WorkingDirectory и User под свой сервер.
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now telegram-bot
#
# Полезные команды:
#   sudo systemctl status telegram-bot   — статус
#   sudo journalctl -u telegram-bot -f   — логи в реальном времени
#   sudo systemctl restart telegram-bot  — перезапуск после обновления кода

[Unit]
Description=Telegram AI bot (Claude)
After=network.target

[Service]
Type=simple
User=REPLACE_WITH_YOUR_USER
WorkingDirectory=/home/REPLACE_WITH_YOUR_USER/liliia-bot
ExecStart=/home/REPLACE_WITH_YOUR_USER/liliia-bot/.venv/bin/python bot.py
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/REPLACE_WITH_YOUR_USER/liliia-bot/.env

[Install]
WantedBy=multi-user.target
