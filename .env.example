# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env никогда не должен попадать в git (он уже в .gitignore).

# Токен бота от @BotFather в Telegram
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# API-ключ Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Необязательные настройки (можно не менять для начала)
# CLAUDE_MODEL=claude-opus-5
# SYSTEM_PROMPT=Ты — дружелюбный ассистент в Telegram.
# MAX_HISTORY_MESSAGES=20
# MAX_TOKENS=2048

# API-ключ Composio (app.composio.dev -> Settings -> API Keys) — нужен только
# для команды /audit (Instagram-аудит). Без него бот работает как обычно.
COMPOSIO_API_KEY=your-composio-api-key-here

# Строка подключения к PostgreSQL (профиль, питание, тренировки, прогресс).
# Создайте базу заранее: createdb nutrition_bot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nutrition_bot
