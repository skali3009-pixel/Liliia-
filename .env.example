# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env никогда не должен попадать в git (он уже в .gitignore).

# Токен бота от @BotFather в Telegram
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# API-ключ Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Строка подключения к PostgreSQL (профиль, питание, тренировки, прогресс).
# Создайте базу заранее: createdb nutrition_bot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nutrition_bot

# Голосовые сообщения (Whisper). У Anthropic такого API нет, поэтому нужен
# отдельный ключ: у Groq есть бесплатный уровень — console.groq.com/keys
VOICE_API_KEY=gsk_your-groq-key-here
# Можно использовать OpenAI вместо Groq:
# VOICE_BASE_URL=https://api.openai.com/v1
# VOICE_MODEL=whisper-1

# Мини-приложение: публичный HTTPS-адрес. Заполняется автоматически
# скриптом setup-webapp.sh — вручную трогать не нужно.
# WEBAPP_URL=https://1-2-3-4.nip.io
# WEBAPP_PORT=8080
# Подпись кнопки приложения в чате (по умолчанию «Кабинет»)
# WEBAPP_BUTTON=Кабинет

# Необязательно: модель для распознавания еды по фото.
# По умолчанию claude-opus-5; дешевле и быстрее — claude-sonnet-5.
# VISION_MODEL=claude-sonnet-5

# --- Платный доступ ---
# Твой Telegram ID (узнать: напиши боту @userinfobot). Можно несколько через запятую.
ADMIN_IDS=
# Бесплатный пробный период для новых людей, дней.
TRIAL_DAYS=7
# Цена месяца в звёздах Telegram (499 ⭐ ≈ 6-7 $ для покупателя).
SUB_PRICE_STARS=499
# PAYWALL=0 открывает бота всем без оплаты.
PAYWALL=1

# --- Документы (оферта, политика данных) ---
# Как тебя указывать в документах: «ИП Иванова Ирина Ивановна» или «Иванова И. И.»
LEGAL_OWNER=
# Реквизиты одной строкой: ИНН, ОГРНИП, адрес для писем.
LEGAL_REQUISITES=
# Почта для вопросов о данных и возвратов — обязательна по 152-ФЗ.
LEGAL_EMAIL=
# Имя бота без @ — попадёт в тексты документов.
BOT_USERNAME=
